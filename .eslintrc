{
  "env": {
    "browser": 2,
    "node": 2,
    "mocha": 2
  },
  "globals": {
    "_": 2,
    "$": 2,
    "angular": 2,
    "jQuery": 2,
    "WS_SERVER": 2,
    "HOME_URL": 2
  },
  "rules": {
    "no-alert": 1,
    "max-params": [1, 10],
    "max-statements": [1, 30],
    "camelcase": [2, {"properties": "never"}],
    "no-underscore-dangle": [2, {"allow": ["_globals"]}],
    "new-cap": [2, {"capIsNewExceptions":["ObjectId","Object","Function","Number","String","Boolean","Date","Array","Symbol","RegExp","Vizabi"]}]
  },
  "extends": "./node_modules/eslint-config-valorsoft/.eslintrc.json"
}
